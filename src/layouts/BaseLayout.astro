---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Curiosity Engine', description = 'Learning in public' } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Technical setup -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- PageTitle + Description -->
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xmml" href="/favicon.svg" />

    <!--Social Media Share Previews -->
    <meta property="og:title" content="Curiosity Engine" />
    <meta property="og:description" content="Learning in public." />
    <meta property="og:type" content="website" />

    <!-- Theme Flashing Protection Script -->
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem('theme');
        if (storedTheme) {
          document.documentElement.setAttribute('data-theme', storedTheme);
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <div class="site-wrapper">
      <Header />
      <!-- Main Content Slot; do not remove -->
      <main class="container main-content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
