---
// src/layouts/BaseLayout.astro
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const { title = "Curiosity Engine", description = "Learning in public" } =
    Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <title>{title}</title>

        <!-- Inline Theme Script: Runs BEFORE page renders to prevent flash -->
        <script is:inline>
            (function () {
                const storedTheme = localStorage.getItem("theme");
                if (storedTheme) {
                    document.documentElement.setAttribute(
                        "data-theme",
                        storedTheme,
                    );
                } else if (
                    window.matchMedia("(prefers-color-scheme: dark)").matches
                ) {
                    document.documentElement.setAttribute("data-theme", "dark");
                } else {
                    document.documentElement.setAttribute(
                        "data-theme",
                        "light",
                    );
                }
            })();
        </script>
    </head>
    <body>
        <!-- Navigation Header -->
        <header class="site-header">
            <div class="container header-content">
                <a href="/" class="site-logo">Curiosity Engine🌱</a>

                <nav class="site-nav">
                    <a href="/about">About</a>
                    <a href="/now">Now</a>
                    <a href="/uses">Uses</a>
                    <button
                        id="theme-toggle"
                        aria-label="Toggle light/dark theme"
                        class="theme-btn"
                    >
                        <span class="icon-sun">☀️</span>
                        <span class="icon-moon">🌙</span>
                    </button>
                </nav>
            </div>
        </header>

        <!-- Main Content Slot -->
        <main class="container main-content">
            <slot />
        </main>

        <!-- Site Footer -->
        <footer class="site-footer">
            <div class="container footer-content">
                <p>
                    © {new Date().getFullYear()} Loura Collignon • Learning in public
                </p>
            </div>
        </footer>

        <!-- Toggle Button Click Script -->
        <script>
            const toggleBtn = document.getElementById("theme-toggle");

            toggleBtn?.addEventListener("click", () => {
                const currentTheme =
                    document.documentElement.getAttribute("data-theme");
                const nextTheme = currentTheme === "dark" ? "light" : "dark";

                document.documentElement.setAttribute("data-theme", nextTheme);
                localStorage.setItem("theme", nextTheme);
            });
        </script>

        <style>
            .site-header {
                border-bottom: 1px solid var(--active-color);
                padding: 1.25rem 0;
            }

            .header-content {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .site-logo {
                font-weight: 700;
                font-size: 1.1rem;
                color: var(--text-color);
            }

            .site-logo:hover {
                text-decoration: none;
                color: var(--accent-color);
            }

            .site-nav {
                display: flex;
                align-items: center;
                gap: 1.25rem;
            }

            .site-nav a {
                color: var(--text-color);
                font-weight: 500;
                font-size: 0.95rem;
            }

            .site-nav a:hover {
                color: var(--accent-color);
                text-decoration: none;
            }

            /* Theme Toggle Button Styling */
            .theme-btn {
                background-color: var(--toggle-bg);
                color: var(--toggle-text);
                border: 1px solid var(--border-color);
                border-radius: 8px;
                padding: 0.35rem 0.6rem;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1rem;
                transition: all 0.2s ease;
            }

            .theme-btn:hover {
                border-color: var(--active-color);
            }

            /* Toggle Sun/Moon icons based on current theme */
            :global([data-theme="light"]) .icon-sun {
                display: none;
            }
            :global([data-theme="light"]) .icon-moon {
                display: inline;
            }

            :global([data-theme="dark"]) .icon-sun {
                display: inline;
            }
            :global([data-theme="dark"]) .icon-moon {
                display: none;
            }

            .main-content {
                padding-top: 2.5rem;
                padding-bottom: 4rem;
                min-height: calc(100vh - 180px);
            }

            .site-footer {
                border-top: 1px solid var(--border-color);
                padding: 1.5rem 0;
                font-size: 0.85rem;
                color: var(--text-muted);
                text-align: center;
            }
        </style>
    </body>
</html>
