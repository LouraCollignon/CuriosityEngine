---
// src/components/ThemeToggle.astro
// (No scipt setup needed in the frontmatter for this component)
---

<!-- 1. HTML for the Toggle -->
<button
  id="theme-toggle"
  aria-label="Toggle light/dark theme"
  class="theme-btn"
>
  <span class="icon-sun">☀️</span>
  <span class="icon-moon">🌙</span>
</button>

<!--  2 Script to make the Toggle function  -->
<script>
  const toggleBtn = document.getElementById('theme-toggle');

  toggleBtn?.addEventListener('click', () => {
    const currentTheme = document.documentElement.getAttribute('data-theme');
    const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';

    document.documentElement.setAttribute('data-theme', nextTheme);
    localStorage.setItem('theme', nextTheme);
  });
</script>

<!--  3 CSS to style the Toggle  -->
<style>
  .theme-btn {
    background-color: transparent;
    color: var(--toggle-text);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 0.35rem 0.6rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    transition: all 0.2s ease;
  }

  .theme-btn:hover {
    border-color: var(--active-color);
  }

  /* Toggle Sun/Moon icons based on current theme */
  :global([data-theme='light']) .icon-sun {
    display: none;
  }
  :global([data-theme='light']) .icon-moon {
    display: inline;
  }

  :global([data-theme='dark']) .icon-sun {
    display: inline;
  }
  :global([data-theme='dark']) .icon-moon {
    display: none;
  }
</style>
