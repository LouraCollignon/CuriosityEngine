---
// src/components/YarnDivider.astro
interface Props {
  color?: string;
}

const { color = 'var(--footer-bg)' } = Astro.props;
---

<div class="yarn-divider-container" aria-hidden="true">
  <svg
    class="yarn-svg"
    viewBox="0 0 60 600"
    preserveAspectRatio="none"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- The Unspooling Thread Path -->
    <path
      d="
      M 30,0
      L 30,60
      C 30,90   55,80   45,110
      C 35,140  10,130  15,160
      C 20,190  45,180  30,210
      L 30,340
      C 30,360  45,355  40,375
      C 35,395  20,390  30,410
      L 30,600
      "
      stroke={color}
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="yarn-path"
    />
  </svg>
</div>

<style>
  .yarn-divider-container {
    display: flex;
    justify-content: center;
    align-items: stretch;
    width: 40px;
    height: 100%;
    min-height: 400px;
  }

  .yarn-svg {
    width: 100%;
    height: 100%;
    /* Allows the straight parts of the line to stretch vertically without distorting the curve */
    vector-effect: non-scaling-stroke;
  }

  .yarn-path {
    /* Optional tactile touch: subtle dash effect to mimic textured yarn */
    stroke-dasharray: 6 2;
    opacity: 0.85;
    transition: opacity 0.3s ease;
  }

  .yarn-divider-container:hover .yarn-path {
    opacity: 1;
  }
</style>
